# Firebase web config (public, bundled into the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Server-only (never prefix these with NEXT_PUBLIC_)
# From Firebase console > Project settings > Service accounts > Generate new private key
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Who is allowed to receive login codes
ADMIN_ALLOWED_EMAILS=you@example.com,another-admin@example.com

# Optional in development: without it, codes are printed to the `npm run dev` console
RESEND_API_KEY=
LOGIN_EMAIL_FROM="Near the Culdesac <login@yourdomain.com>"
